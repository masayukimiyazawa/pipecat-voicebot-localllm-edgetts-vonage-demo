# LM Studio (local LLM)
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_MODEL=gemma-4-26B-A4B-it-MLX-8bit

# STT (local Whisper via mlx-whisper)
STT_LANGUAGE=ja

# Audio settings
VONAGE_AUDIO_RATE=16000

# --- Vonage (required) ---
VONAGE_APPLICATION_ID=your_application_id
VONAGE_PRIVATE_KEY=./private.key

# Optional: override public WebSocket URL (auto-detected from request host otherwise)
# WS_URI=wss://your-cloudflare-tunnel-url/ws

# Vonage Voice API Webhook URL
# Set this in Vonage Dashboard > Voice > Applications > Your App > Answer URL
# VONAGE_WEBHOOK_URL=https://your-cloudflare-tunnel-url/voice/webhook
