# LM Studio (local LLM)
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_MODEL=gemma-4-26B-A4B-it-MLX-8bit

# STT (local Whisper via faster-whisper)
STT_LANGUAGE=ja
STT_MODEL=whisper-1

# Audio settings
VONAGE_AUDIO_RATE=16000

# TTS (pyopenjtalk — Japanese HTS engine, no model download needed)
# See tts_piper_plus.py for speed/half_tone settings

# --- Vonage Video API (required for demo) ---
VONAGE_APPLICATION_ID=your_application_id
VONAGE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----"
# VONAGE_PRIVATE_KEY=/path/to/private.key

# Optional: override public WebSocket URL (auto-detected via cloudflared otherwise)
# WS_URI=wss://your-cloudflare-tunnel-url/ws

# Vonage Voice API Webhook URL (auto-set by start.sh)
# Set this in Vonage Dashboard > Voice > Applications > Your App > Answer URL
# VONAGE_WEBHOOK_URL=https://your-cloudflare-tunnel-url/voice/webhook

# PIPER_PLUS_VOICE_ID=ja_JP-neural-medium
# PIPER_PLUS_DOWNLOAD_DIR=~/piper-voices